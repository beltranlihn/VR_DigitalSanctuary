;; hall_director.dsl — grafos de BP_HallDirector_SC (Mechanics/Hall). Sesión "Inicio y Hall de acceso", 2026-09-30.
;; Un write_graph_dsl POR GRAFO, en grafos NUEVOS/VACÍOS. Variables en categoría Default al escribir (se categorizan después).
;; Bools: getter SIN la b. Llamadas propias por KEYWORD. VERIFICAR marcados con [V] contra find_node_types antes de pegar.
;; VO (índices del array VO): 0 01a · 1 01b · 2 01c · 3 01d · 4 01h · 5 02 · 6 03 · 7 03h · 8 04 · 9 04b · 10 05 ·
;;   11 06a · 12 06b · 13 06c · 14 06d · 15 06e · 16 06f · 17 06g · 18 07 · 19 34a · 20 35a

;; ===== GRAFO: EventGraph — PASO 1: los 4 custom events + Tick (sin add_event: los crea el write). PASO 2 (otro write): BeginPlay
(event EventBeginPlay
  (CallFunction|HallBoot)
  (if (or (or (Variables|Default|GetTestIntro) (Variables|Default|GetTestReturn)) (Variables|Default|GetTestExit))
    (Utilities|FlowControl|Delay :Duration (Variables|Default|GetTestDelay))
    (Utilities|Time|SetGlobalTimeDilation :TimeDilation (Variables|Default|GetTestSpeed))
    (if (Variables|Default|GetTestIntro)
      (CallFunction|HallIntro)
      (else (if (Variables|Default|GetTestReturn)
        (CallFunction|HallReturn)
        (elif (Variables|Default|GetTestExit)
          (CallFunction|HallExit)))))))

;; Regla de la obra (Narrativa): Dt = min(DeltaTime, 1/30) -> un cuadro trabado no se come la entrada.
(event EventTick (DeltaSeconds)
  (bind _dt (Math|Float|Min(Float) DeltaSeconds 0.0333))
  (CallFunction|HallTickWalk :DT _dt)
  (CallFunction|HallTickDoors :DT _dt)
  (CallFunction|HallTickTiles :DT _dt)
  (CallFunction|HallTickTouch :DT _dt)
  (CallFunction|HallTickLead :DT _dt)
  (CallFunction|HallTickSteps :DT _dt))

(event Custom|HallIntro ()
  (Variables|Default|SetHallDone false)
  (Variables|Default|SetMode 1)
  (Variables|Default|SetStep -1)
  (Variables|Default|SetStepTime 0.0)
  (Variables|Default|SetStepDur 0.0)
  (Variables|Default|SetGate true)
  (Variables|Default|SetWaitWalk false))

(event Custom|HallReturn ()
  (Variables|Default|SetReturnDone false)
  (Variables|Default|SetMode 2)
  (Variables|Default|SetStep -1)
  (Variables|Default|SetStepTime 0.0)
  (Variables|Default|SetStepDur 0.0)
  (Variables|Default|SetGate true)
  (Variables|Default|SetWaitWalk false))

(event Custom|HallExit ()
  (Variables|Default|SetExitDone false)
  (Variables|Default|SetMode 3)
  (Variables|Default|SetStep -1)
  (Variables|Default|SetStepTime 0.0)
  (Variables|Default|SetStepDur 0.0)
  (Variables|Default|SetGate true)
  (Variables|Default|SetWaitWalk false))

(event Custom|HallPulse ()
  (Game|Feedback|SetHapticsByValue :self (Game|GetPlayerController 0) :Frequency 1.0 :Amplitude 0.8 :Hand "Right")
  (Game|Feedback|SetHapticsByValue :self (Game|GetPlayerController 0) :Frequency 1.0 :Amplitude 0.8 :Hand "Left")
  (Utilities|FlowControl|Delay :Duration 0.15)
  (Game|Feedback|SetHapticsByValue :self (Game|GetPlayerController 0) :Frequency 0.0 :Amplitude 0.0 :Hand "Right")
  (Game|Feedback|SetHapticsByValue :self (Game|GetPlayerController 0) :Frequency 0.0 :Amplitude 0.0 :Hand "Left"))

;; ===== GRAFO: Boot  (sin parámetros)
;; Cachea referencias por clase/tag (en la Obra: la celda Test_Hall + el persistente). Hojas por tag hall_leaf:
;; signo = sign(x*y) del centro de sus bounds relativo al hall (abrir = alejarse del centro de su puerta); este = x > 0.
(fn HallBoot ()
  (Variables|Default|SetPawn (Actor|GetActorOfClass :ActorClass "/Game/SoulCharger/Core/Pawn/BP_VRPawn_SC.BP_VRPawn_SC_C"))
  (Variables|Default|SetAlma (Actor|GetActorOfClass :ActorClass "/Game/SoulCharger/Core/Alma/BP_Alma_SC.BP_Alma_SC_C"))
  (Variables|Default|SetLights (Actor|GetActorOfClass :ActorClass "/Game/SoulCharger/Mechanics/Hall/BP_HallLights_SC.BP_HallLights_SC_C"))
  (Variables|Default|SetPicker (Actor|GetActorOfClass :ActorClass "/Game/SoulCharger/Core/ProtoSoul/BP_SoulPicker_SC.BP_SoulPicker_SC_C"))
  (bind _here (Transformation|GetActorLocation))
  (bind _lv (Actor|GetAllActorswithTag "hall_leaf"))
  (Variables|Default|SetLeaves _lv)
  (for _a _lv
    (bind (_o _e) (Collision|GetActorBounds :self _a :bOnlyCollidingComponents false))
    (bind _rx (- (.x _o) (.x _here)))
    (bind _ry (- (.y _o) (.y _here)))
    (Utilities|Array|Add (Variables|Default|GetLeafYaw) (.yaw (Transformation|GetActorRotation :self _a)))
    (Utilities|Array|Add (Variables|Default|GetLeafSign) (select (> (* _rx _ry) 0.0) 1.0 -1.0))
    (Utilities|Array|Add (Variables|Default|GetLeafEast) (> _rx 0.0)))
  (bind _ta (Actor|GetAllActorswithTag "hall_tiles"))
  (bind _tm (Actor|GetComponentByClass (Utilities|Array|Get(acopy) _ta 0) "/Script/Engine.StaticMeshComponent"))
  (for _i (range 5)
    (Utilities|Array|Add (Variables|Default|GetTileMIDs) (Rendering|Material|CreateDynamicMaterialInstance :self _tm :ElementIndex _i :SourceMaterial (Rendering|Material|GetMaterial :self _tm :ElementIndex _i))))
  (Utilities|Array|Resize (Variables|Default|GetTileCur) 5)
  (Utilities|Array|Resize (Variables|Default|GetTileTgt) 5)
  (Utilities|Array|Add (Variables|Default|GetTitleComps) (Variables|Default|GetTitle0))
  (Utilities|Array|Add (Variables|Default|GetTitleComps) (Variables|Default|GetTitle1))
  (Utilities|Array|Add (Variables|Default|GetTitleComps) (Variables|Default|GetTitle2))
  (Utilities|Array|Add (Variables|Default|GetTitleComps) (Variables|Default|GetTitle3))
  (Utilities|Array|Add (Variables|Default|GetTitleComps) (Variables|Default|GetTitle4))
  (for _t (Variables|Default|GetTitleComps)
    (Rendering|Material|SetScalarParameterValueonMaterials _t "Reveal" 0.0)))

;; ===== GRAFO: TickSteps  (DT float)
(fn HallTickSteps (DT)
  (if (> (Variables|Default|GetMode) 0)
    (Variables|Default|SetStepTime (+ (Variables|Default|GetStepTime) DT))
    ;; espera de caminata SIN estado de flanco: si el paso espera la llegada y la caminata ya terminó, abre (PIE 1: la
    ;; caminata terminaba durante el VO anterior y el paso 5 quedaba esperando para siempre)
    (Variables|Default|SetGate (or (Variables|Default|GetGate) (and (Variables|Default|GetWaitWalk) (>= (Variables|Default|GetWalkT) (Variables|Default|GetWalkDur)))))
    (Variables|Default|SetWaitWalk (and (Variables|Default|GetWaitWalk) (< (Variables|Default|GetWalkT) (Variables|Default|GetWalkDur))))
    (if (and (>= (Variables|Default|GetStepTime) (Variables|Default|GetStepDur)) (Variables|Default|GetGate))
      (Variables|Default|SetStep (+ (Variables|Default|GetStep) 1))
      (Variables|Default|SetStepTime 0.0)
      (Variables|Default|SetStepDur 0.0)
      (Variables|Default|SetGate true)
      (Development|PrintString (Utilities|String|Append (Utilities|String|Append "HALL: modo " (Utilities|String|ToString(Integer) (Variables|Default|GetMode))) (Utilities|String|Append " paso " (Utilities|String|ToString(Integer) (Variables|Default|GetStep)))) :bPrintToScreen false)
      (switch int (Variables|Default|GetMode)
        (:0)
        (:1 (CallFunction|HallEnterIntro))
        (:2 (CallFunction|HallEnterReturn))
        (:3 (CallFunction|HallEnterExit))))))

;; ===== GRAFO: EnterIntro  (sin parámetros) — del inicio a cruzar la puerta Este con el HUD nacido
(fn HallEnterIntro ()
  (switch int (Variables|Default|GetStep)
    (:0
      (CallFunction|HallTeleport :To (Variables|Default|GetStopStart))
      (Variables|Default|SetDoorW 0.0) (Variables|Default|SetDoorWT 0.0)
      (Variables|Default|SetDoorE 0.0) (Variables|Default|SetDoorET 0.0)
      (Variables|Default|SetHudBorn false)
      (Variables|Default|SetTileGain (Variables|Default|GetTileGlowMax))
      (Variables|Default|SetTitles true)
      (CallFunction|HallTiles :Count 5 :V 0.0)
      (CallFunction|HallLight :Lit false)
      (CallFunction|HallAlmaHide)
      (CallFunction|HallFogSet :Lit true)
      ;; IntroHold = 12 s QUIETOS en la niebla azul (el título de la Obra entra y sale en ese tiempo; pedido de Beltrán)
      (Variables|Default|SetStepDur 12.0))
    (:1
      ;; la caminata SIN pasos (HallWalk no los arranca en este paso); la niebla se va a negro en BP_HallFog_SC.FadeOut (12 s)
      (CallFunction|HallWalk :To (Variables|Default|GetStopDoor) :Dur (Variables|Default|GetJourneyTime))
      (CallFunction|HallFogSet :Lit false)
      (Variables|Default|SetStepDur 3.0))
    (:2 (CallFunction|HallSay :I 0) (Variables|Default|SetStepDur (+ (Variables|Default|GetStepDur) 4.0)))
    (:3 (CallFunction|HallSay :I 1) (Variables|Default|SetStepDur (+ (Variables|Default|GetStepDur) 4.0)))
    (:4
      ;; último tramo (~4 s antes de llegar): se enciende el portal y recién ahora suenan los pasos
      (CallFunction|HallSay :I 2)
      (CallFunction|HallLight :Lit true)
      (Variables|Default|SetStepsAudio (Audio|SpawnSound2D :Sound (Variables|Default|GetSndSteps) :VolumeMultiplier 0.6)))
    (:5
      (Variables|Default|SetWaitWalk true)
      (Variables|Default|SetGate false)
      (Variables|Default|SetStepDur 1.0))
    (:6
      (CallFunction|HallSpawnBell)
      (CallFunction|HallSay :I 3)
      (Variables|Default|SetStepDur 0.5))
    (:7
      (Audio|PlaySound2D :Sound (Variables|Default|GetSndBell))
      (Class|BPCAppearLuzSC|Vanish (Class|BPBellArtSC|GetAppear (Variables|Default|GetBell)))
      (Actor|SetLifeSpan :self (Variables|Default|GetBell) :InLifespan 2.0)
      (Variables|Default|SetStepDur 0.8))
    (:8 (CallFunction|HallDoor :East false :Open 1.0) (Variables|Default|SetStepDur 2.0))
    (:9 (CallFunction|HallWalk :To (Variables|Default|GetStopInside) :Dur (Variables|Default|GetEnterTime)) (Variables|Default|SetStepDur 2.5))
    (:10
      (CallFunction|HallAlmaAppear :Tag "hall_alma_center")
      (Variables|Default|SetWaitWalk true)
      (Variables|Default|SetGate false))
    (:11 (CallFunction|HallDoor :East false :Open 0.0) (CallFunction|HallSay :I 5))
    (:12
      (CallFunction|HallAlmaMove :Tag "hall_alma_side")
      (CallFunction|HallSpawnSensor)
      (CallFunction|HallSay :I 6))
    (:13 (Variables|Default|SetStepDur 1.0))
    (:14 (CallFunction|HallSay :I 8) (CallFunction|HallPickStart))
    (:15 (CallFunction|HallSay :I 10))
    (:16 (CallFunction|HallSay :I 11))
    (:17 (CallFunction|HallTiles :Count 1 :V 1.0) (CallFunction|HallSay :I 12))
    (:18 (CallFunction|HallTiles :Count 2 :V 1.0) (CallFunction|HallSay :I 13))
    (:19 (CallFunction|HallTiles :Count 3 :V 1.0) (CallFunction|HallSay :I 14))
    (:20 (CallFunction|HallTiles :Count 4 :V 1.0) (CallFunction|HallSay :I 15))
    (:21 (CallFunction|HallTiles :Count 5 :V 1.0) (CallFunction|HallSay :I 16))
    (:22 (CallFunction|HallSay :I 17))
    (:23 (CallFunction|HallTiles :Count 5 :V 0.0) (Variables|Default|SetStepDur 2.5))
    (:24 (CallFunction|HallHudBirth) (Variables|Default|SetStepDur 3.0))
    (:25 (CallFunction|HallSay :I 18))
    (:26
      (CallFunction|HallAlmaMove :Tag "hall_alma_exit")
      (Rendering|Material|SetVectorParameterValue :Collection "/Game/SoulCharger/Mechanics/Hall/MPC_Hall_SC.MPC_Hall_SC" :ParameterName "DoorColor" :ParameterValue (Variables|Default|GetDoorCold))
      (Variables|Default|SetStepDur 2.5))
    (:27 (CallFunction|HallAlmaHide) (CallFunction|HallDoor :East true :Open 1.0) (Variables|Default|SetStepDur 2.0))
    (:28 (CallFunction|HallWalk :To (Variables|Default|GetStopFar) :Dur (Variables|Default|GetOutTime)) (Variables|Default|SetStepDur 6.0))
    (:29
      (CallFunction|HallLight :Lit false)
      (Variables|Default|SetWaitWalk true)
      (Variables|Default|SetGate false))
    (:30
      (CallFunction|HallDoor :East true :Open 0.0)
      (Actor|SetLifeSpan :self (Variables|Default|GetSensor) :InLifespan 0.1)
      (Variables|Default|SetHallDone true)
      (Variables|Default|SetMode 0)
      (Development|PrintString "HALL: HallIntro terminado (bHallDone)" :bPrintToScreen false))))

;; ===== GRAFO: EnterReturn  (sin parámetros) — de la oscuridad hasta adentro, sin timbre
(fn HallEnterReturn ()
  (switch int (Variables|Default|GetStep)
    (:0
      (CallFunction|HallTeleport :To (Variables|Default|GetStopReturn))
      (CallFunction|HallLight :Lit false)
      (Variables|Default|SetDoorW 0.0) (Variables|Default|SetDoorWT 0.0)
      (Variables|Default|SetDoorE 0.0) (Variables|Default|SetDoorET 0.0)
      (CallFunction|HallAlmaHide)
      (Variables|Default|SetTileGain (Variables|Default|GetReturnGlow))
      (Variables|Default|SetTitles false)
      (Rendering|Material|SetVectorParameterValue :Collection "/Game/SoulCharger/Mechanics/Hall/MPC_Hall_SC.MPC_Hall_SC" :ParameterName "DoorColor" :ParameterValue (Variables|Default|GetDoorWarm))
      (Variables|Default|SetStepDur 2.0))
    (:1 (CallFunction|HallTiles :Count 5 :V 1.0) (CallFunction|HallLight :Lit true) (Variables|Default|SetStepDur 2.5))
    (:2 (CallFunction|HallDoor :East true :Open 1.0) (Variables|Default|SetStepDur 1.5))
    (:3
      (CallFunction|HallWalk :To (Variables|Default|GetStopCard) :Dur (Variables|Default|GetReturnTime))
      (CallFunction|HallSay :I 19)
      (Variables|Default|SetStepDur 1.0))
    (:4 (Variables|Default|SetWaitWalk true) (Variables|Default|SetGate false))
    (:5 (CallFunction|HallDoor :East true :Open 0.0) (Variables|Default|SetStepDur 1.0))
    (:6
      (Variables|Default|SetReturnDone true)
      (Variables|Default|SetMode 0)
      (Development|PrintString "HALL: HallReturn terminado (bReturnDone)" :bPrintToScreen false))))

;; ===== GRAFO: EnterExit  (sin parámetros) — salir por la puerta Oeste al espacio etéreo
(fn HallEnterExit ()
  (switch int (Variables|Default|GetStep)
    (:0
      ;; si la Obra ya abrió la Oeste (rama SHARE: el alma sale sola con HallDoor(false, 1)), no se reabre ni vuelve a sonar
      (Variables|Default|SetStepDur 2.0)
      (if (Variables|Default|GetTestExit)
        (CallFunction|HallTeleport :To (Variables|Default|GetStopCard))
        (CallFunction|HallDoor :East false :Open 1.0)
        (else (if (< (Variables|Default|GetDoorWT) 0.5)
          (CallFunction|HallDoor :East false :Open 1.0)))))
    (:1
      (CallFunction|HallWalk :To (Variables|Default|GetStopExit) :Dur (Variables|Default|GetExitTime))
      (CallFunction|HallSay :I 20)
      (Variables|Default|SetStepDur 7.0))
    (:2
      (CallFunction|HallLight :Lit false)
      (CallFunction|HallTiles :Count 5 :V 0.0)
      (CallFunction|HallFogSet :Lit true)
      (Variables|Default|SetWaitWalk true)
      (Variables|Default|SetGate false))
    (:3
      (CallFunction|HallDoor :East false :Open 0.0)
      (Variables|Default|SetExitDone true)
      (Variables|Default|SetMode 0)
      (Development|PrintString "HALL: HallExit terminado (bExitDone)" :bPrintToScreen false))))

;; ===== GRAFO: Say  (I int) — voz de Alma EN SU POSICIÓN (SpawnSoundAtLocation, pedido de Narrativa; no Speak: su VOClips es el viejo); el paso dura el clip + VOAir
(fn HallSay (I)
  (bind _c (Utilities|Array|Get(acopy) (Variables|Default|GetVO) I))
  (Variables|Default|SetStepDur (+ (Class|SoundBase|GetDuration _c) (Variables|Default|GetVOAir)))
  (Utilities|IsValid (Variables|Default|GetAlma)
    (:"Is Valid" (Audio|SpawnSoundatLocation :Sound _c :Location (Transformation|GetActorLocation :self (Variables|Default|GetAlma))))
    (:"Is Not Valid" (Audio|PlaySound2D :Sound _c))))

;; ===== GRAFO: Teleport  (To SceneComponent)
(fn HallTeleport (To)
  (Transformation|SetActorLocationAndRotation :self (Variables|Default|GetPawn) :NewLocation (Transformation|GetWorldLocation :self To) :NewRotation (Math|Rotator|MakeRotator :Yaw (.yaw (Transformation|GetWorldRotation :self To))) :bSweep false :bTeleport true)
  (Variables|Default|SetWalkDur 0.0)
  (Variables|Default|SetWalkT 0.0))

;; ===== GRAFO: Walk  (To SceneComponent, Dur float)
(fn HallWalk (To Dur)
  (Variables|Default|SetWalkA (Transformation|GetActorLocation :self (Variables|Default|GetPawn)))
  (Variables|Default|SetWalkB (Transformation|GetWorldLocation :self To))
  (Variables|Default|SetWalkT 0.0)
  (Variables|Default|SetWalkDur (Math|Float|Max(Float) Dur 0.1))
  ;; el viaje del inicio (HallIntro paso 1) camina en silencio: los pasos los arranca el paso 4 al llegar
  (if (not (and (== (Variables|Default|GetMode) 1) (== (Variables|Default|GetStep) 1)))
    (Variables|Default|SetStepsAudio (Audio|SpawnSound2D :Sound (Variables|Default|GetSndSteps) :VolumeMultiplier 0.6))))

;; ===== GRAFO: TickWalk  (DT float) — perfil trapecio: acelera AccelTime, frena BrakeTime con desaceleración constante
(fn HallTickWalk (DT)
  (if (< (Variables|Default|GetWalkT) (Variables|Default|GetWalkDur))
    (Variables|Default|SetWalkT (Math|Float|Min(Float) (+ (Variables|Default|GetWalkT) DT) (Variables|Default|GetWalkDur)))
    (bind _d (Variables|Default|GetWalkDur))
    (bind _u (/ (Variables|Default|GetWalkT) _d))
    (bind _a (Math|Float|Clamp(Float) (/ (Variables|Default|GetAccelTime) _d) :Min 0.01 :Max 0.45))
    (bind _b (Math|Float|Clamp(Float) (/ (Variables|Default|GetBrakeTime) _d) :Min 0.01 :Max 0.45))
    (bind _v (/ 1.0 (- 1.0 (* 0.5 (+ _a _b)))))
    (bind _r (- 1.0 _u))
    (bind _s (select (< _u _a) (/ (* _v (* _u _u)) (* 2.0 _a)) (select (> _u (- 1.0 _b)) (- 1.0 (/ (* _v (* _r _r)) (* 2.0 _b))) (* _v (- _u (* 0.5 _a))))))
    (bind _A (Variables|Default|GetWalkA))
    (bind _B (Variables|Default|GetWalkB))
    (Transformation|SetActorLocation :self (Variables|Default|GetPawn) :NewLocation (Math|Vector|MakeVector (+ (.x _A) (* (- (.x _B) (.x _A)) _s)) (+ (.y _A) (* (- (.y _B) (.y _A)) _s)) (+ (.z _A) (* (- (.z _B) (.z _A)) _s))) :bSweep false :bTeleport true)
    (if (>= (Variables|Default|GetWalkT) _d)
      (Variables|Default|SetGate (or (Variables|Default|GetGate) (Variables|Default|GetWaitWalk)))
      (Variables|Default|SetWaitWalk false)
      (Utilities|IsValid (Variables|Default|GetStepsAudio)
        (:"Is Valid" (Audio|Components|Audio|Stop (Variables|Default|GetStepsAudio)))
        (:"Is Not Valid")))))

;; ===== GRAFO: Door  (East bool, Open float)
(fn HallDoor (East Open)
  (Variables|Default|SetDoorET (select East Open (Variables|Default|GetDoorET)))
  (Variables|Default|SetDoorWT (select East (Variables|Default|GetDoorWT) Open))
  (if (> Open 0.5)
    (Audio|PlaySound2D :Sound (Variables|Default|GetSndDoor) :VolumeMultiplier 0.8)))

;; ===== GRAFO: TickDoors  (DT float) — hojas con pivote en el eje: abrir = girar en Z ±DoorOpenDeg
(fn HallTickDoors (DT)
  (bind _k (/ 1.0 (Math|Float|Max(Float) (Variables|Default|GetDoorTime) 0.1)))
  (Variables|Default|SetDoorW (Math|Interpolation|FInterptoConstant (Variables|Default|GetDoorW) (Variables|Default|GetDoorWT) DT _k))
  (Variables|Default|SetDoorE (Math|Interpolation|FInterptoConstant (Variables|Default|GetDoorE) (Variables|Default|GetDoorET) DT _k))
  (bind _lv (Variables|Default|GetLeaves))
  (for _i (range (Utilities|Array|Length _lv))
    (bind _o (Math|Float|FInterpEaseinOut 0.0 1.0 (select (Utilities|Array|Get(acopy) (Variables|Default|GetLeafEast) _i) (Variables|Default|GetDoorE) (Variables|Default|GetDoorW)) 2.0))
    (Transformation|SetActorRotation :self (Utilities|Array|Get(acopy) _lv _i) :NewRotation (Math|Rotator|MakeRotator :Yaw (+ (Utilities|Array|Get(acopy) (Variables|Default|GetLeafYaw) _i) (* (* (Utilities|Array|Get(acopy) (Variables|Default|GetLeafSign) _i) (Variables|Default|GetDoorOpenDeg)) _o))) :bTeleportPhysics true)))

;; ===== GRAFO: Tiles  (Count int, V float) — objetivo de las baldosas 0..Count-1
(fn HallTiles (Count V)
  (for _i (range Count)
    (Utilities|Array|SetArrayElem (Variables|Default|GetTileTgt) _i V :bSizeToFit true)))

;; ===== GRAFO: TickTiles  (DT float) — ApplyTile ANTES de SetArrayElem (el bind puro se re-evalúa: gotcha bind)
(fn HallTickTiles (DT)
  (bind _k (/ 1.0 (Math|Float|Max(Float) (Variables|Default|GetTileTime) 0.1)))
  (for _i (range 5)
    (bind _c (Utilities|Array|Get(acopy) (Variables|Default|GetTileCur) _i))
    (bind _t (Utilities|Array|Get(acopy) (Variables|Default|GetTileTgt) _i))
    (if (!= _c _t)
      (bind _n (Math|Interpolation|FInterptoConstant _c _t DT _k))
      (CallFunction|HallApplyTile :I _i :V _n)
      (Utilities|Array|SetArrayElem (Variables|Default|GetTileCur) _i _n))))

;; ===== GRAFO: ApplyTile  (I int, V float) — Lift (cm, WPO) y TileGlow en la MID del slot I; título encima
;; [V] Rendering|Material|SetScalarParameterValue puede resolver al overload de MPC (gotchas 142/291/2432).
;;     Si el write falla con "... to Collection": escribir SIN esas dos líneas y crear los dos nodos con
;;     create_node declaring_class /Script/Engine.MaterialInstanceDynamic (receta en el plan del turno).
(fn HallApplyTile (I V)
  (bind _e (Math|Float|FInterpEaseinOut 0.0 1.0 V 2.0))
  (bind _m (Utilities|Array|Get(acopy) (Variables|Default|GetTileMIDs) I))
  (Rendering|Material|SetScalarParameterValue :self _m :ParameterName "Lift" :Value (* _e (Variables|Default|GetTileLiftCm)))
  (Rendering|Material|SetScalarParameterValue :self _m :ParameterName "TileGlow" :Value (* _e (Variables|Default|GetTileGain)))
  (Rendering|Material|SetScalarParameterValueonMaterials (Utilities|Array|Get(acopy) (Variables|Default|GetTitleComps) I) "Reveal" (select (Variables|Default|GetTitles) _e 0.0)))

;; ===== GRAFO: Reach  (Fwd float, Down float, Side float) — punto alcanzable relativo a la cámara (yaw solo)
(fn HallReach (Fwd Down Side)
  (bind _cm (Game|GetPlayerCameraManager 0))
  (bind _eye (Camera|GetCameraLocation _cm))
  (bind _rot (Math|Rotator|MakeRotator :Yaw (.yaw (Camera|GetCameraRotation _cm))))
  (bind _f (Math|Vector|GetForwardVector _rot))
  (bind _r (Math|Vector|GetRightVector _rot))
  (Variables|Default|SetEyeLoc _eye)
  (Variables|Default|SetReachLoc (Math|Vector|MakeVector (+ (+ (.x _eye) (* (.x _f) Fwd)) (* (.x _r) Side)) (+ (+ (.y _eye) (* (.y _f) Fwd)) (* (.y _r) Side)) (- (.z _eye) Down))))

;; ===== GRAFO: SpawnBell  (sin parámetros) — el timbre con su cara hacia los ojos
(fn HallSpawnBell ()
  (CallFunction|HallReach :Fwd (Variables|Default|GetReachFwd) :Down (Variables|Default|GetReachDown) :Side 0.0)
  (bind _loc (Variables|Default|GetReachLoc))
  (bind _b (Game|SpawnActorfromClass "/Game/SoulCharger/Mechanics/Bell/BP_BellArt_SC.BP_BellArt_SC_C" (Math|Transform|MakeTransform :Location _loc :Rotation (Math|Rotator|MakeRotfromZ (- (Variables|Default|GetEyeLoc) _loc))) "AlwaysSpawn"))
  (Variables|Default|SetBell _b)
  (Class|BPCAppearLuzSC|Prepare (Class|BPBellArtSC|GetAppear (Variables|Default|GetBell)))
  (Class|BPCAppearLuzSC|Appear (Class|BPBellArtSC|GetAppear (Variables|Default|GetBell)))
  (Variables|Default|SetBellCharge 0.0)
  (Variables|Default|SetBellLive true)
  (Variables|Default|SetGate false))

;; ===== GRAFO: SpawnSensor  (sin parámetros) — el sensor (FaceAxis -Z) con la cara hacia los ojos
(fn HallSpawnSensor ()
  (CallFunction|HallReach :Fwd (Variables|Default|GetReachFwd) :Down (Variables|Default|GetReachDown) :Side 0.0)
  (bind _loc (Variables|Default|GetReachLoc))
  (bind _s (Game|SpawnActorfromClass "/Game/SoulCharger/Mechanics/BioSensor/BP_BioSensorArt_SC.BP_BioSensorArt_SC_C" (Math|Transform|MakeTransform :Location _loc :Rotation (Math|Rotator|MakeRotfromZ (- _loc (Variables|Default|GetEyeLoc)))) "AlwaysSpawn"))
  (Variables|Default|SetSensor _s)
  (Class|BPCAppearLuzSC|Prepare (Class|BPBioSensorArtSC|GetAppear (Variables|Default|GetSensor)))
  (Class|BPCAppearLuzSC|Appear (Class|BPBioSensorArtSC|GetAppear (Variables|Default|GetSensor)))
  (Variables|Default|SetSensorLive true)
  (Variables|Default|SetGate false))

;; ===== GRAFO: TickTouch  (DT float) — timbre (sostener BellHold s; suelta = baja en 0,5 s; FW_Bell) y sensor (tocar; FW_Tool)
(fn HallTickTouch (DT)
  (CallFunction|HallTickPick)
  (bind _p (Variables|Default|GetPawn))
  (bind _gr (Transformation|GetWorldLocation :self (Class|BPVRPawnSC|GetMotionControllerRightGrip _p)))
  (bind _gl (Transformation|GetWorldLocation :self (Class|BPVRPawnSC|GetMotionControllerLeftGrip _p)))
  (bind _R (Variables|Default|GetTouchRadius))
  (if (Variables|Default|GetBellLive)
    (bind _bl (Transformation|GetActorLocation :self (Variables|Default|GetBell)))
    (bind _nr (< (Math|Vector|Distance(Vector) _gr _bl) _R))
    (bind _nl (< (Math|Vector|Distance(Vector) _gl _bl) _R))
    (bind _go (or (or _nr _nl) (> (Variables|Default|GetStepTime) (Variables|Default|GetFWBell))))
    (Variables|Default|SetBellCharge (Math|Float|Clamp(Float) (+ (Variables|Default|GetBellCharge) (* DT (select _go (/ 1.0 (Math|Float|Max(Float) (Variables|Default|GetBellHold) 0.1)) -2.0)))))
    (bind _q (Variables|Default|GetBellCharge))
    (Rendering|Material|SetScalarParameterValueonMaterials (Class|BPBellArtSC|GetSlider (Variables|Default|GetBell)) "Progress" _q)
    (Rendering|Material|SetScalarParameterValueonMaterials (Class|BPBellArtSC|GetBase (Variables|Default|GetBell)) "Glow" (+ 0.7 (* 0.9 _q)))
    (Game|Feedback|SetHapticsByValue :self (Game|GetPlayerController 0) :Frequency 0.5 :Amplitude (select _nr (+ 0.15 (* 0.45 _q)) 0.0) :Hand "Right")
    (Game|Feedback|SetHapticsByValue :self (Game|GetPlayerController 0) :Frequency 0.5 :Amplitude (select _nl (+ 0.15 (* 0.45 _q)) 0.0) :Hand "Left")
    (if (>= _q 1.0)
      (Variables|Default|SetBellLive false)
      (Variables|Default|SetGate true)
      (CallFunction|HallPulse))
    (elif (Variables|Default|GetSensorLive)
      (bind _sl (Transformation|GetActorLocation :self (Variables|Default|GetSensor)))
      (bind _dr (Math|Vector|Distance(Vector) _gr _sl))
      (bind _dl (Math|Vector|Distance(Vector) _gl _sl))
      (bind _to (> (Variables|Default|GetStepTime) (Variables|Default|GetFWTool)))
      (if (or (or (< _dr _R) (< _dl _R)) _to)
        (CallFunction|HallGrab :Right (or (<= _dr _dl) _to))))))

;; ===== GRAFO: Grab  (Right bool) — el sensor queda en esa mano; esa mano = la hábil de toda la obra
(fn HallGrab (Right)
  (Variables|Default|SetRightHanded Right)
  (Variables|Default|SetSensorLive false)
  (Variables|Default|SetGate true)
  (bind _p (Variables|Default|GetPawn))
  (Transformation|AttachActorToComponent :self (Variables|Default|GetSensor) :Parent (select Right (Class|BPVRPawnSC|GetMotionControllerRightGrip _p) (Class|BPVRPawnSC|GetMotionControllerLeftGrip _p)) :LocationRule "SnapToTarget" :RotationRule "KeepWorld" :ScaleRule "KeepWorld" :bWeldSimulatedBodies false)
  (CallFunction|HallPulse))

;; ===== GRAFO: AlmaAppear (Tag name) / AlmaMove (Tag name) / AlmaHide () / Light (Lit bool)
(fn HallAlmaAppear (Tag)
  (Utilities|IsValid (Variables|Default|GetAlma)
    (:"Is Valid" (Class|BPAlmaSC|AppearAt (Variables|Default|GetAlma) :PointTag Tag))
    (:"Is Not Valid")))

(fn HallAlmaMove (Tag)
  (Utilities|IsValid (Variables|Default|GetAlma)
    (:"Is Valid" (Class|BPAlmaSC|MoveTo (Variables|Default|GetAlma) :PointTag Tag))
    (:"Is Not Valid")))

(fn HallAlmaHide ()
  (Utilities|IsValid (Variables|Default|GetAlma)
    (:"Is Valid" (Class|BPAlmaSC|Disappear (Variables|Default|GetAlma)))
    (:"Is Not Valid")))

(fn HallLight (Lit)
  (Utilities|IsValid (Variables|Default|GetLights)
    (:"Is Valid"
      (if Lit
        (Class|BPHallLightsSC|LightsOn (Variables|Default|GetLights))
        (else (Class|BPHallLightsSC|LightsOff (Variables|Default|GetLights)))))
    (:"Is Not Valid")))

;; ===== GRAFO: HallHudBirth  (sin parámetros) — el Hall NO toca el HUD: marca el momento; la Obra lo conecta (Narrativa T2b)
(fn HallHudBirth ()
  (Variables|Default|SetHudBorn true)
  (Development|PrintString "HALL: nace el HUD (bHudBorn)" :bPrintToScreen false))

;; ===== T2 (quedan VACÍOS en T1): PickStart · TickPick · TickLead · FogSet
;; HudBirth: (bind _h (Actor|GetActorOfClass :ActorClass ".../BP_SoulHUD3D_SC.BP_SoulHUD3D_SC_C")) → IsValid → HudBirth.
;; PickStart: colocar Souls alcanzables (semicírculo, Reach por cada una) → Picker.Awake → bPickLive → Gate false.
;; TickPick: si bPickLive: Picker.bChosen → ChosenSoul = índice de Winner en Souls; > FW_Choose → elegir la del centro.
;; TickLead: LeadActor ~1,5 m delante del pawn mientras camina en modo 2/3.
;; FogSet: cast Fog → BP_HallFog_SC → FogOn/FogOff.
