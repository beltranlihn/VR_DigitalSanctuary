(fn HallTickTiles (DT)
  (bind _k (/ 1.0 (Math|Float|Max(Float) (Variables|Default|GetTileTime) 0.1)))
  (for _i (range 5)
    (bind _c (Utilities|Array|Get(acopy) (Variables|Default|GetTileCur) _i))
    (bind _t (Utilities|Array|Get(acopy) (Variables|Default|GetTileTgt) _i))
    (if (!= _c _t)
      (bind _n (Math|Interpolation|FInterptoConstant _c _t DT _k))
      (CallFunction|HallApplyTile :I _i :V _n)
      (Utilities|Array|SetArrayElem (Variables|Default|GetTileCur) _i _n))))