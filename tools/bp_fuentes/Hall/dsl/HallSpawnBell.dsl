(fn HallSpawnBell ()
  (CallFunction|HallReach :Fwd (Variables|Default|GetReachFwd) :Down (Variables|Default|GetReachDown) :Side 0.0)
  (bind _loc (Variables|Default|GetReachLoc))
  (bind _b (Game|SpawnActorfromClass "/Game/SoulCharger/Mechanics/Bell/BP_BellArt_SC.BP_BellArt_SC_C" (Math|Transform|MakeTransform :Location _loc :Rotation (Math|Rotator|MakeRotfromZ (- (Variables|Default|GetEyeLoc) _loc))) "AlwaysSpawn"))
  (Variables|Default|SetBell _b)
  (Variables|Default|SetBellRest (Class|SceneComponent|GetRelativeLocation (Class|BPBellArtSC|GetButton (Variables|Default|GetBell))))
  (Variables|Default|SetBellPress 0.0)
  (Class|BPCAppearLuzSC|Prepare (Class|BPBellArtSC|GetAppear (Variables|Default|GetBell)))
  (Class|BPCAppearLuzSC|Appear (Class|BPBellArtSC|GetAppear (Variables|Default|GetBell)))
  (Variables|Default|SetBellCharge 0.0)
  (Variables|Default|SetBellLive true)
  (Variables|Default|SetGate false))