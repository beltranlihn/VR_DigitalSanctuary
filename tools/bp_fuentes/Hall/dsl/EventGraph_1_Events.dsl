(event EventTick (DeltaSeconds)
  (bind _dt (Math|Float|Min(Float) DeltaSeconds 0.0333))
  (CallFunction|HallTickWalk :DT _dt)
  (CallFunction|HallTickDoors :DT _dt)
  (CallFunction|HallTickTiles :DT _dt)
  (CallFunction|HallTickTouch :DT _dt)
  (CallFunction|HallTickLead :DT _dt)
  (CallFunction|HallTickSteps :DT _dt))

(event Custom|HallIntro ()
  (Variables|Default|SetHallDone false)
  (Variables|Default|SetMode 1)
  (Variables|Default|SetStep -1)
  (Variables|Default|SetStepTime 0.0)
  (Variables|Default|SetStepDur 0.0)
  (Variables|Default|SetGate true)
  (Variables|Default|SetWaitWalk false))

(event Custom|HallReturn ()
  (Variables|Default|SetReturnDone false)
  (Variables|Default|SetMode 2)
  (Variables|Default|SetStep -1)
  (Variables|Default|SetStepTime 0.0)
  (Variables|Default|SetStepDur 0.0)
  (Variables|Default|SetGate true)
  (Variables|Default|SetWaitWalk false))

(event Custom|HallExit ()
  (Variables|Default|SetExitDone false)
  (Variables|Default|SetMode 3)
  (Variables|Default|SetStep -1)
  (Variables|Default|SetStepTime 0.0)
  (Variables|Default|SetStepDur 0.0)
  (Variables|Default|SetGate true)
  (Variables|Default|SetWaitWalk false))

(event Custom|HallPulse ()
  (Game|Feedback|SetHapticsByValue :self (Game|GetPlayerController 0) :Frequency 1.0 :Amplitude 0.8 :Hand "Right")
  (Game|Feedback|SetHapticsByValue :self (Game|GetPlayerController 0) :Frequency 1.0 :Amplitude 0.8 :Hand "Left")
  (Utilities|FlowControl|Delay :Duration 0.15)
  (Game|Feedback|SetHapticsByValue :self (Game|GetPlayerController 0) :Frequency 0.0 :Amplitude 0.0 :Hand "Right")
  (Game|Feedback|SetHapticsByValue :self (Game|GetPlayerController 0) :Frequency 0.0 :Amplitude 0.0 :Hand "Left"))