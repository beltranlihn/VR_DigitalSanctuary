(fn HallGrab (Right)
  (Variables|Default|SetRightHanded Right)
  (Variables|Default|SetSensorLive false)
  (Variables|Default|SetGate true)
  (bind _p (Variables|Default|GetPawn))
  (Transformation|AttachActorToComponent :self (Variables|Default|GetSensor) :Parent (select Right (Class|BPVRPawnSC|GetMotionControllerRightGrip _p) (Class|BPVRPawnSC|GetMotionControllerLeftGrip _p)) :LocationRule "SnapToTarget" :RotationRule "KeepWorld" :ScaleRule "KeepWorld" :bWeldSimulatedBodies false)
  (CallFunction|HallPulse)
  (if (< (Variables|Default|GetStepTime) (Variables|Default|GetStepDur))
    (Variables|Default|SetStepDur (+ (Variables|Default|GetStepTime) 0.3))
    (Development|PrintString "HALL: voz cortada (el usuario resolvio antes de que terminara)" :bPrintToScreen false)
    (Utilities|IsValid (Variables|Default|GetAlma)
      (:"Is Valid" (Class|BPAlmaSC|FadeVoice :self (Variables|Default|GetAlma) :Time 0.3))
      (:"Is Not Valid"))))
