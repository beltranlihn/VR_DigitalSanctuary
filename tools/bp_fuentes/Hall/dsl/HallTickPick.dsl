(fn HallTickPick ()
  (if (Variables|Default|GetPickLive)
    (if (Class|BPSoulPickerSC|GetChosen (Variables|Default|GetPicker))
      (Variables|Default|SetChosenSoul (Utilities|Array|FindItem (Variables|Default|GetSouls) (Class|BPSoulPickerSC|GetWinner (Variables|Default|GetPicker))))
      (Variables|Default|SetPickLive false)
      (Variables|Default|SetGate true)
      (Development|PrintString (Utilities|String|Append "HALL: alma elegida " (Utilities|String|ToString(Integer) (Variables|Default|GetChosenSoul))) :bPrintToScreen false)
      (if (< (Variables|Default|GetStepTime) (Variables|Default|GetStepDur))
        (Variables|Default|SetStepDur (+ (Variables|Default|GetStepTime) 0.3))
        (Development|PrintString "HALL: voz cortada (el usuario resolvio antes de que terminara)" :bPrintToScreen false)
        (Utilities|IsValid (Variables|Default|GetAlma)
          (:"Is Valid" (Class|BPAlmaSC|FadeVoice :self (Variables|Default|GetAlma) :Time 0.3))
          (:"Is Not Valid")))
      (elif (> (Variables|Default|GetStepTime) (Variables|Default|GetFWChoose))
        (bind _c (Utilities|Casting|CastToBP_ProtoSoul_SC :Object (Utilities|Array|Get(acopy) (Variables|Default|GetSouls) 0))
          (:then
            (Class|BPProtoSoulSC|SetHovering :self _c :bHovering true)
            (Class|BPSoulPickerSC|Judge :self (Variables|Default|GetPicker) :S _c))
          (:CastFailed (Class|BPSoulPickerSC|ForceChoose (Variables|Default|GetPicker))))))))
