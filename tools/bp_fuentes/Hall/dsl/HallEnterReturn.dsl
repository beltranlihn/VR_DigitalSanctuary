(fn HallEnterReturn ()
  (switch int (Variables|Default|GetStep)
    (:0
      (CallFunction|HallTeleport :To (Variables|Default|GetStopReturn))
      (CallFunction|HallLight :Lit false)
      (Variables|Default|SetDoorW 0.0) (Variables|Default|SetDoorWT 0.0)
      (Variables|Default|SetDoorE 0.0) (Variables|Default|SetDoorET 0.0)
      (CallFunction|HallAlmaHide)
      (Variables|Default|SetTileGain (Variables|Default|GetReturnGlow))
      (Variables|Default|SetTitles false)
      (Rendering|Material|SetVectorParameterValue :Collection "/Game/SoulCharger/Mechanics/Hall/MPC_Hall_SC.MPC_Hall_SC" :ParameterName "DoorColor" :ParameterValue (Variables|Default|GetDoorWarm))
      (Variables|Default|SetStepDur (Variables|Default|GetPaceReturnDark)))
    (:1 (CallFunction|HallTiles :Count 5 :V 1.0) (CallFunction|HallLight :Lit true) (Variables|Default|SetStepDur (Variables|Default|GetPaceReturnLight)))
    (:2 (CallFunction|HallDoor :East true :Open 1.0) (Variables|Default|SetStepDur (Variables|Default|GetPaceReturnDoor)))
    (:3
      (CallFunction|HallWalk :To (Variables|Default|GetStopCard) :Dur (Variables|Default|GetReturnTime))
      (CallFunction|HallSay :I 19)
      (Variables|Default|SetStepDur (Variables|Default|GetPaceReturnVO)))
    (:4 (Variables|Default|SetWaitWalk true) (Variables|Default|SetGate false))
    (:5 (CallFunction|HallDoor :East true :Open 0.0) (Variables|Default|SetStepDur (Variables|Default|GetPaceDoorClose)))
    (:6
      (Variables|Default|SetReturnDone true)
      (Variables|Default|SetMode 0)
      (Development|PrintString "HALL: HallReturn terminado (bReturnDone)" :bPrintToScreen false))))