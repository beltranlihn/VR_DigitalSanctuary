(fn HallTickSteps (DT)
  (if (> (Variables|Default|GetMode) 0)
    (Variables|Default|SetStepTime (+ (Variables|Default|GetStepTime) DT))
    (if (and (>= (Variables|Default|GetStepTime) (Variables|Default|GetStepDur)) (Variables|Default|GetGate))
      (Variables|Default|SetStep (+ (Variables|Default|GetStep) 1))
      (Variables|Default|SetStepTime 0.0)
      (Variables|Default|SetStepDur 0.0)
      (Variables|Default|SetGate true)
      (Development|PrintString (Utilities|String|Append (Utilities|String|Append "HALL: modo " (Utilities|String|ToString(Integer) (Variables|Default|GetMode))) (Utilities|String|Append " paso " (Utilities|String|ToString(Integer) (Variables|Default|GetStep)))) :bPrintToScreen false)
      (switch int (Variables|Default|GetMode)
        (:0)
        (:1 (CallFunction|HallEnterIntro))
        (:2 (CallFunction|HallEnterReturn))
        (:3 (CallFunction|HallEnterExit))))))