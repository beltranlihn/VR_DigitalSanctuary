(fn HallTickTouch (DT)
  (CallFunction|HallTickPick)
  (bind _p (Variables|Default|GetPawn))
  (bind _gr (Transformation|GetWorldLocation :self (Class|BPVRPawnSC|GetMotionControllerRightGrip _p)))
  (bind _gl (Transformation|GetWorldLocation :self (Class|BPVRPawnSC|GetMotionControllerLeftGrip _p)))
  (bind _R (Variables|Default|GetTouchRadius))
  (if (Variables|Default|GetBellLive)
    (bind _bl (Transformation|GetActorLocation :self (Variables|Default|GetBell)))
    (bind _nr (< (Math|Vector|Distance(Vector) _gr _bl) _R))
    (bind _nl (< (Math|Vector|Distance(Vector) _gl _bl) _R))
    (bind _go (or (or _nr _nl) (> (Variables|Default|GetStepTime) (Variables|Default|GetFWBell))))
    (Variables|Default|SetBellCharge (Math|Float|Clamp(Float) (+ (Variables|Default|GetBellCharge) (* DT (select _go (/ 1.0 (Math|Float|Max(Float) (Variables|Default|GetBellHold) 0.1)) -2.0)))))
    (bind _q (Variables|Default|GetBellCharge))
    (bind _pr (or _nr _nl))
    (Variables|Default|SetBellPress (Math|Interpolation|FInterptoConstant (Variables|Default|GetBellPress) (select _pr 1.0 0.0) DT (/ 1.0 (Math|Float|Max(Float) (Variables|Default|GetBellPressTime) 0.02))))
    (bind _btn (Class|BPBellArtSC|GetButton (Variables|Default|GetBell)))
    (bind _rest (Variables|Default|GetBellRest))
    (bind _dz (* (Variables|Default|GetBellPressDepth) (Math|Float|FInterpEaseinOut 0.0 1.0 (Variables|Default|GetBellPress) 2.0)))
    (Transformation|SetRelativeLocation _btn :NewLocation (select (or _pr (> (Variables|Default|GetBellPress) 0.001)) (Math|Vector|MakeVector (.x _rest) (.y _rest) (- (.z _rest) _dz)) (Class|SceneComponent|GetRelativeLocation _btn)) :bSweep false :bTeleport true)
    (Rendering|Material|SetScalarParameterValueonMaterials (Class|BPBellArtSC|GetSlider (Variables|Default|GetBell)) "Progress" _q)
    (Rendering|Material|SetScalarParameterValueonMaterials (Class|BPBellArtSC|GetBase (Variables|Default|GetBell)) "Glow" (+ 0.7 (* 0.9 _q)))
    (Game|Feedback|SetHapticsByValue :self (Game|GetPlayerController 0) :Frequency 0.5 :Amplitude (select _nr (+ 0.15 (* 0.45 _q)) 0.0) :Hand "Right")
    (Game|Feedback|SetHapticsByValue :self (Game|GetPlayerController 0) :Frequency 0.5 :Amplitude (select _nl (+ 0.15 (* 0.45 _q)) 0.0) :Hand "Left")
    (if (>= _q 1.0)
      (Variables|Default|SetBellLive false)
      (Variables|Default|SetGate true)
      (CallFunction|HallPulse))
    (elif (Variables|Default|GetSensorLive)
      (bind _sl (Transformation|GetActorLocation :self (Variables|Default|GetSensor)))
      (bind _dr (Math|Vector|Distance(Vector) _gr _sl))
      (bind _dl (Math|Vector|Distance(Vector) _gl _sl))
      (bind _to (> (Variables|Default|GetStepTime) (Variables|Default|GetFWTool)))
      (if (or (or (< _dr _R) (< _dl _R)) _to)
        (CallFunction|HallGrab :Right (or (<= _dr _dl) _to))))))