(fn HallEnterIntro ()
  (switch int (Variables|Default|GetStep)
    (:0
      (Variables|Default|SetDoorW 0.0) (Variables|Default|SetDoorWT 0.0)
      (Variables|Default|SetDoorE 0.0) (Variables|Default|SetDoorET 0.0)
      (Variables|Default|SetHudBorn false)
      (Variables|Default|SetTileGain (Variables|Default|GetTileGlowMax))
      (Variables|Default|SetTitles true)
      (CallFunction|HallTiles :Count 5 :V 0.0)
      (CallFunction|HallAlmaHide)
      (if (and (Variables|Default|GetTestIntro) (> (Variables|Default|GetTestfromStep) 1))
        (CallFunction|HallLight :Lit true)
        (Variables|Default|SetStep (- (Variables|Default|GetTestfromStep) 1))
        (Variables|Default|SetStepDur 0.0)
        (Development|PrintString (Utilities|String|Append "HALL: ensayo desde el paso " (Utilities|String|ToString(Integer) (Variables|Default|GetTestfromStep))) :bPrintToScreen false)
        (bind _tp (Actor|GetAllActorswithTag "hall_pawn"))
        (if (> (Utilities|Array|Length _tp) 0)
          (Transformation|SetActorLocationAndRotation :self (Variables|Default|GetPawn) :NewLocation (Transformation|GetActorLocation :self (Utilities|Array|Get(acopy) _tp 0)) :NewRotation (Math|Rotator|MakeRotator :Yaw (.yaw (Transformation|GetActorRotation :self (Utilities|Array|Get(acopy) _tp 0)))) :bSweep false :bTeleport true)
          (Variables|Default|SetWalkDur 0.0)
          (Variables|Default|SetWalkT 0.0)
          (else (if (< (Variables|Default|GetTestfromStep) 10)
            (CallFunction|HallTeleport :To (Variables|Default|GetStopDoor))
            (else (CallFunction|HallTeleport :To (Variables|Default|GetStopInside))))))
        (else
          (CallFunction|HallLight :Lit false)
          (CallFunction|HallFogSet :Lit true)
          (Variables|Default|SetStepDur (Variables|Default|GetIntroHold))
          (CallFunction|HallTeleport :To (Variables|Default|GetStopStart)))))
    (:1
      (CallFunction|HallWalk :To (Variables|Default|GetStopDoor) :Dur (Variables|Default|GetJourneyTime))
      (CallFunction|HallFogSet :Lit false)
      (Variables|Default|SetStepDur (Variables|Default|GetPaceWalkToVO)))
    (:2 (CallFunction|HallSay :I 0) (Variables|Default|SetStepDur (+ (Variables|Default|GetStepDur) (Variables|Default|GetPaceJourneyPause))))
    (:3 (CallFunction|HallSay :I 1) (Variables|Default|SetStepDur (+ (Variables|Default|GetStepDur) (Variables|Default|GetPaceJourneyPause))))
    (:4
      (CallFunction|HallSay :I 2)
      (CallFunction|HallLight :Lit true)
      (Variables|Default|SetStepsAudio (Audio|SpawnSound2D :Sound (Variables|Default|GetSndSteps) :VolumeMultiplier 0.6)))
    (:5
      (Variables|Default|SetWaitWalk true)
      (Variables|Default|SetGate false)
      (Variables|Default|SetStepDur (Variables|Default|GetPaceArrive)))
    (:6
      (CallFunction|HallSpawnBell)
      (CallFunction|HallSay :I 3)
      (Variables|Default|SetStepDur (Variables|Default|GetPaceBellVO)))
    (:7
      (Audio|PlaySound2D :Sound (Variables|Default|GetSndBell))
      (Class|BPCAppearLuzSC|Vanish (Class|BPBellArtSC|GetAppear (Variables|Default|GetBell)))
      (Actor|SetLifeSpan :self (Variables|Default|GetBell) :InLifespan 2.0)
      (Variables|Default|SetStepDur (Variables|Default|GetPaceBellRing)))
    (:8 (CallFunction|HallDoor :East false :Open 1.0) (Variables|Default|SetStepDur (Variables|Default|GetPaceDoorOpen)))
    (:9 (CallFunction|HallWalk :To (Variables|Default|GetStopInside) :Dur (Variables|Default|GetEnterTime)) (Variables|Default|SetStepDur (Variables|Default|GetPaceAlmaAppear)))
    (:10
      (CallFunction|HallAlmaAppear :Tag "hall_alma_center")
      (Variables|Default|SetWaitWalk true)
      (Variables|Default|SetGate false))
    (:11 (CallFunction|HallDoor :East false :Open 0.0) (CallFunction|HallSay :I 5))
    (:12
      (CallFunction|HallAlmaMove :Tag "hall_alma_side")
      (CallFunction|HallSpawnSensor)
      (CallFunction|HallSay :I 6))
    (:13 (Variables|Default|SetStepDur (Variables|Default|GetPaceAfterTool)))
    (:14 (CallFunction|HallSay :I 8) (CallFunction|HallPickStart))
    (:15 (CallFunction|HallSay :I 10))
    (:16 (CallFunction|HallSay :I 11))
    (:17 (CallFunction|HallTiles :Count 1 :V 1.0) (CallFunction|HallSay :I 12))
    (:18 (CallFunction|HallTiles :Count 2 :V 1.0) (CallFunction|HallSay :I 13))
    (:19 (CallFunction|HallTiles :Count 3 :V 1.0) (CallFunction|HallSay :I 14))
    (:20 (CallFunction|HallTiles :Count 4 :V 1.0) (CallFunction|HallSay :I 15))
    (:21 (CallFunction|HallTiles :Count 5 :V 1.0) (CallFunction|HallSay :I 16))
    (:22 (CallFunction|HallSay :I 17))
    (:23 (CallFunction|HallTiles :Count 5 :V 0.0) (Variables|Default|SetStepDur (Variables|Default|GetPaceTilesOff)))
    (:24 (CallFunction|HallHudBirth) (Variables|Default|SetStepDur (Variables|Default|GetPaceHudBirth)))
    (:25 (CallFunction|HallSay :I 18))
    (:26
      (CallFunction|HallAlmaMove :Tag "hall_alma_exit")
      (Rendering|Material|SetVectorParameterValue :Collection "/Game/SoulCharger/Mechanics/Hall/MPC_Hall_SC.MPC_Hall_SC" :ParameterName "DoorColor" :ParameterValue (Variables|Default|GetDoorCold))
      (Variables|Default|SetStepDur (Variables|Default|GetPaceFollowMe)))
    (:27 (CallFunction|HallAlmaHide) (CallFunction|HallDoor :East true :Open 1.0) (Variables|Default|SetStepDur (Variables|Default|GetPaceDoorOpen)))
    (:28 (CallFunction|HallWalk :To (Variables|Default|GetStopFar) :Dur (Variables|Default|GetOutTime)) (Variables|Default|SetStepDur (Variables|Default|GetPaceLightsOffOut)))
    (:29
      (CallFunction|HallLight :Lit false)
      (Variables|Default|SetWaitWalk true)
      (Variables|Default|SetGate false))
    (:30
      (CallFunction|HallDoor :East true :Open 0.0)
      (Actor|SetLifeSpan :self (Variables|Default|GetSensor) :InLifespan 0.1)
      (Variables|Default|SetHallDone true)
      (Variables|Default|SetMode 0)
      (Development|PrintString "HALL: HallIntro terminado (bHallDone)" :bPrintToScreen false))))